---
// The interactive terminal. Used by the live home page and by the draft
// preview, so both behave identically.
interface Props {
  outputs: Record<string, string>;
  prompt: string;
  bootCommand: string;
}
const { outputs, prompt, bootCommand } = Astro.props;
---

<div id="screen"></div>
<form id="input-line" autocomplete="off">
  <span class="prompt" id="ps1">{prompt}</span>
  <input id="stdin" type="text" aria-label="terminal input" autofocus />
</form>

<script is:inline define:vars={{ OUTPUTS: outputs, PS1: prompt, BOOT: bootCommand }}>
  const screen = document.getElementById('screen');
  const stdin = document.getElementById('stdin');

  // Snake, played on a character grid so it looks like it belongs in a
  // terminal. A built-in rather than content, since it needs a game loop —
  // unlike hidden text commands, which are just documents left out of the
  // homepage's help listing.
  let snakeActive = false;

  function startSnake() {
    if (snakeActive) return;
    snakeActive = true;

    const COLS = 30;
    const ROWS = 15;
    const TICK = 110;

    const out = document.createElement('div');
    out.className = 'out snake';
    const board = document.createElement('pre');
    const hud = document.createElement('div');
    hud.className = 'snake-hud';
    out.append(board, hud);
    screen.appendChild(out);

    let snake = [{ x: 8, y: 7 }];
    let dir = { x: 1, y: 0 };
    let queued = null;
    let food = placeFood();
    let score = 0;
    let timer = null;

    function placeFood() {
      // Never drop food under the snake.
      let spot;
      do {
        spot = { x: (Math.random() * COLS) | 0, y: (Math.random() * ROWS) | 0 };
      } while (snake.some((s) => s.x === spot.x && s.y === spot.y));
      return spot;
    }

    function draw(message) {
      const grid = Array.from({ length: ROWS }, () => Array(COLS).fill('·'));
      grid[food.y][food.x] = '●';
      snake.forEach((s, i) => {
        grid[s.y][s.x] = i === 0 ? '█' : '▓';
      });
      board.textContent = grid.map((row) => row.join(' ')).join('\n');
      hud.textContent = message ?? `score ${score} · arrows or wasd to steer · q to quit`;
    }

    function stop(message) {
      clearInterval(timer);
      document.removeEventListener('keydown', onKey, true);
      snakeActive = false;
      draw(message);
      stdin.focus();
    }

    function step() {
      if (queued) {
        dir = queued;
        queued = null;
      }
      const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };

      const hitWall = head.x < 0 || head.y < 0 || head.x >= COLS || head.y >= ROWS;
      const hitSelf = snake.some((s) => s.x === head.x && s.y === head.y);
      if (hitWall || hitSelf) {
        stop(`game over · score ${score} · type snake to play again`);
        return;
      }

      snake.unshift(head);
      if (head.x === food.x && head.y === food.y) {
        score += 1;
        food = placeFood();
      } else {
        snake.pop();
      }
      draw();
    }

    function onKey(e) {
      const k = e.key.toLowerCase();
      const moves = {
        arrowup: { x: 0, y: -1 },
        w: { x: 0, y: -1 },
        arrowdown: { x: 0, y: 1 },
        s: { x: 0, y: 1 },
        arrowleft: { x: -1, y: 0 },
        a: { x: -1, y: 0 },
        arrowright: { x: 1, y: 0 },
        d: { x: 1, y: 0 },
      };
      if (k === 'q' || k === 'escape') {
        e.preventDefault();
        stop(`quit · score ${score}`);
        return;
      }
      const move = moves[k];
      if (!move) return;
      // Stop arrows scrolling the page, and ignore reversing into yourself.
      e.preventDefault();
      if (move.x === -dir.x && move.y === -dir.y) return;
      queued = move;
    }

    // Capture phase, so the focused input never sees these keys.
    document.addEventListener('keydown', onKey, true);
    stdin.blur();
    draw();
    timer = setInterval(step, TICK);
  }

  function run(cmd) {
    const line = document.createElement('div');
    line.className = 'cmd-line';
    const ps1 = document.createElement('span');
    ps1.className = 'prompt';
    ps1.textContent = PS1;
    line.append(ps1, ' ' + cmd);
    screen.appendChild(line);

    if (cmd === 'clear') {
      screen.innerHTML = '';
    } else if (cmd === 'snake') {
      startSnake();
      window.scrollTo(0, document.body.scrollHeight);
      return;
    } else if (Object.prototype.hasOwnProperty.call(OUTPUTS, cmd)) {
      const out = document.createElement('div');
      out.className = 'out';
      out.innerHTML = OUTPUTS[cmd];
      screen.appendChild(out);
    } else if (cmd) {
      const out = document.createElement('div');
      out.className = 'out';
      out.textContent = `command not found: ${cmd} — try \`help\`\n`;
      screen.appendChild(out);
    }
    stdin.focus();
    window.scrollTo(0, document.body.scrollHeight);
  }

  // Delegated so build-time markup can stay inert strings.
  screen.addEventListener('click', (e) => {
    const btn = e.target.closest('button.cmd');
    if (btn) run(btn.dataset.cmd);
  });

  document.getElementById('input-line').addEventListener('submit', (e) => {
    e.preventDefault();
    run(stdin.value.trim().toLowerCase());
    stdin.value = '';
  });

  // keep focus on the terminal input (but never steal a text selection, and
  // leave the input alone while a game is running)
  document.body.addEventListener('click', () => {
    if (snakeActive) return;
    if (!window.getSelection()?.toString()) stdin.focus();
  });

  run(BOOT);

  // A landing page can hand a command back to the terminal via ?run=…
  const requested = new URLSearchParams(location.search).get('run');
  if (requested && Object.prototype.hasOwnProperty.call(OUTPUTS, requested)) {
    run(requested);
  }
</script>
