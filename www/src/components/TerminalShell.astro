---
// The interactive terminal. Used by the live home page and by the draft
// preview, so both behave identically.
interface Props {
  outputs: Record<string, string>;
  prompt: string;
  bootCommand: string;
}
const { outputs, prompt, bootCommand } = Astro.props;
---

<div id="screen"></div>
<form id="input-line" autocomplete="off">
  <span class="prompt" id="ps1">{prompt}</span>
  <input id="stdin" type="text" aria-label="terminal input" autofocus />
</form>

<script is:inline define:vars={{ OUTPUTS: outputs, PS1: prompt, BOOT: bootCommand }}>
  const screen = document.getElementById('screen');
  const stdin = document.getElementById('stdin');

  function run(cmd) {
    const line = document.createElement('div');
    line.className = 'cmd-line';
    const ps1 = document.createElement('span');
    ps1.className = 'prompt';
    ps1.textContent = PS1;
    line.append(ps1, ' ' + cmd);
    screen.appendChild(line);

    if (cmd === 'clear') {
      screen.innerHTML = '';
    } else if (Object.prototype.hasOwnProperty.call(OUTPUTS, cmd)) {
      const out = document.createElement('div');
      out.className = 'out';
      out.innerHTML = OUTPUTS[cmd];
      screen.appendChild(out);
    } else if (cmd) {
      const out = document.createElement('div');
      out.className = 'out';
      out.textContent = `command not found: ${cmd} — try \`help\`\n`;
      screen.appendChild(out);
    }
    stdin.focus();
    window.scrollTo(0, document.body.scrollHeight);
  }

  // Delegated so build-time markup can stay inert strings.
  screen.addEventListener('click', (e) => {
    const btn = e.target.closest('button.cmd');
    if (btn) run(btn.dataset.cmd);
  });

  document.getElementById('input-line').addEventListener('submit', (e) => {
    e.preventDefault();
    run(stdin.value.trim().toLowerCase());
    stdin.value = '';
  });

  // keep focus on the terminal input (but never steal a text selection)
  document.body.addEventListener('click', () => {
    if (!window.getSelection()?.toString()) stdin.focus();
  });

  run(BOOT);

  // A landing page can hand a command back to the terminal via ?run=…
  const requested = new URLSearchParams(location.search).get('run');
  if (requested && Object.prototype.hasOwnProperty.call(OUTPUTS, requested)) {
    run(requested);
  }
</script>
