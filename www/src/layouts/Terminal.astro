---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <style is:global>
      :root {
        --bg: #0d1117;
        --fg: #c9d1d9;
        --dim: #8b949e;
        --green: #3fb950;
        --link: #58a6ff;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        background: var(--bg);
        color: var(--fg);
        font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
        font-size: 15px;
        line-height: 1.5;
        padding: 1.5rem 1rem 4rem;
      }

      main {
        max-width: 720px;
        margin: 0 auto;
      }

      .prompt {
        color: var(--green);
      }

      .cmd-line {
        margin-top: 1rem;
      }

      .out {
        white-space: pre-wrap;
        color: var(--fg);
      }

      .out .dim {
        color: var(--dim);
      }

      a {
        color: var(--link);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      button.cmd {
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        color: var(--link);
        cursor: pointer;
      }

      button.cmd:hover {
        text-decoration: underline;
      }

      #input-line {
        display: flex;
        margin-top: 1rem;
        align-items: baseline;
      }

      #stdin {
        flex: 1;
        background: none;
        border: none;
        outline: none;
        font: inherit;
        color: var(--fg);
        caret-color: var(--green);
        padding: 0 0 0 0.5ch;
      }

      .out.snake pre {
        margin: 0.4rem 0 0.2rem;
        line-height: 1.15;
        color: var(--green);
        /* The grid is drawn with characters, so it must not wrap or reflow. */
        white-space: pre;
        overflow-x: auto;
      }

      .snake-hud {
        color: var(--dim);
        font-size: 0.9em;
      }

      table.inv {
        border-collapse: collapse;
        margin: 0.25rem 0 0.5rem 2ch;
      }

      table.inv td {
        padding: 0 2.5ch 0 0;
        vertical-align: baseline;
      }

      /* The blog listing is the same table with a date and a kind in front.
         Dates are fixed-width so the titles line up down the column. */
      table.entries td:first-child {
        white-space: nowrap;
      }

      table.entries td:nth-child(2) {
        padding-right: 2ch;
      }

      /* Notes sit under their book, indented into the author column. */
      table.books td.note {
        padding-bottom: 0.35rem;
      }

      /* The contact form. Inputs are underlines rather than boxes, so the form
         reads as part of the terminal rather than a widget dropped into it. */
      .contact-form {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin: 0.4rem 0 0.5rem 2ch;
        max-width: 52ch;
      }

      .contact-form label {
        display: flex;
        align-items: baseline;
        gap: 1ch;
      }

      .contact-form input,
      .contact-form textarea {
        flex: 1;
        min-width: 0;
        background: none;
        border: none;
        border-bottom: 1px solid var(--dim);
        outline: none;
        font: inherit;
        color: var(--fg);
        caret-color: var(--green);
        padding: 0 0 0.15rem;
      }

      .contact-form textarea {
        resize: vertical;
      }

      .contact-form input:focus,
      .contact-form textarea:focus {
        border-bottom-color: var(--green);
      }

      .contact-form button {
        align-self: flex-start;
        background: none;
        border: 1px solid var(--dim);
        font: inherit;
        color: var(--link);
        cursor: pointer;
        padding: 0.1rem 1.5ch;
      }

      .contact-form button:hover:not(:disabled) {
        border-color: var(--link);
      }

      .contact-form button:disabled {
        color: var(--dim);
        cursor: default;
      }

      /* Off-screen rather than display:none, which many bots skip. */
      .contact-form .honeypot {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        opacity: 0;
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
