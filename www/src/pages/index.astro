---
import Terminal from '../layouts/Terminal.astro';
import TerminalShell from '../components/TerminalShell.astro';
import { getSiteContent } from '../lib/sanity';
import { buildTerminalData } from '../lib/outputs';

// Prerendered: visitors get a static file off the CDN. Only the preview routes
// need a server.
export const prerender = true;

const content = await getSiteContent();
const { settings, homepage } = content;
const { outputs, builtins, variants, notFoundMessage } = buildTerminalData(content);
---

<Terminal
  title={settings?.siteTitle ?? 'Magnus Hillestad'}
  description={homepage?.metaDescription ?? settings?.metaDescription}
>
  <TerminalShell
    outputs={outputs}
    builtins={builtins}
    variants={variants}
    notFoundMessage={notFoundMessage}
    prompt={settings?.prompt ?? 'magnus@mhillestad.com:~$'}
    bootCommand={homepage?.bootCommand ?? 'help'}
  />
</Terminal>
