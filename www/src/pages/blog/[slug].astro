---
import Terminal from '../../layouts/Terminal.astro';
import { getSiteContent } from '../../lib/sanity';
import { renderBody } from '../../lib/render';

// One static route per blog post written in Sanity. Posts live under /blog/ so
// they can never collide with a landing page's slug at the root.
export const prerender = true;

export async function getStaticPaths() {
  const { settings, homepage, posts, entries, books, podcasts } = await getSiteContent();
  const ctx = { groups: homepage?.investmentGroups ?? [], entries, books, podcasts };
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, ctx, settings },
  }));
}

const { post, ctx, settings } = Astro.props;
const prompt = settings?.prompt ?? 'magnus@mhillestad.com:~$';
const backLabel = settings?.backLinkLabel ?? 'cd ~';
const html = renderBody(post.body, ctx);
---

<Terminal
  title={`${post.title} — ${settings?.siteTitle ?? 'Magnus Hillestad'}`}
  description={post.metaDescription}
>
  <div id="screen">
    <div class="cmd-line">
      <span class="prompt">{prompt}</span> {`cat blog/${post.slug}`}
    </div>
    <div class="dim">{post.date}</div>
    <div class="out" set:html={html} />
    <div class="cmd-line"><span class="prompt">{prompt}</span> <a href="/">{backLabel}</a></div>
  </div>
</Terminal>

<script is:inline>
  // Command buttons inside post bodies send the visitor to the terminal and
  // run there, since there is no shell on a post page.
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('button.cmd');
    if (btn) window.location.href = `/?run=${encodeURIComponent(btn.dataset.cmd)}`;
  });
</script>
